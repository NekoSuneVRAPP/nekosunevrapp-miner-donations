{
  "private": true,
  "name": "nekosunevrapp-miner-donations",
  "version": "0.4.2",
  "description": "Basic miner interface for NekoSuneVRAPP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "packager": "npm run packager:win:x64",
    "packager:win:x64": "electron-packager . nekosunevrapp-miner-donations --platform=win32 --arch=x64 --icon=icon.ico --out=./dist --overwrite --ignore=\"^/miner($|/)\" --ignore=\"^/app/miner($|/)\" --ignore=\"^/dist($|/)\"",
    "packager:linux:x64": "electron-packager . nekosunevrapp-miner-donations --platform=linux --arch=x64 --icon=app/img/logo-header.png --out=./dist --overwrite --ignore=\"^/miner($|/)\" --ignore=\"^/app/miner($|/)\" --ignore=\"^/dist($|/)\"",
    "packager:linux:arm64": "electron-packager . nekosunevrapp-miner-donations --platform=linux --arch=arm64 --icon=app/img/logo-header.png --out=./dist --overwrite --ignore=\"^/miner($|/)\" --ignore=\"^/app/miner($|/)\" --ignore=\"^/dist($|/)\"",
    "packager:linux:armv7l": "electron-packager . nekosunevrapp-miner-donations --platform=linux --arch=armv7l --icon=app/img/logo-header.png --out=./dist --overwrite --ignore=\"^/miner($|/)\" --ignore=\"^/app/miner($|/)\" --ignore=\"^/dist($|/)\""
  },
  "dependencies": {
    "axios": "^0.18.1",
    "bootstrap": "^4.1.0",
    "discord-rich-presence": "0.0.8",
    "electron-settings": "^3.1.4",
    "font-awesome": "^4.7.0",
    "jquery": "^3.4.1",
    "moment": "^2.22.1",
    "numeral": "^2.0.6",
    "popper.js": "^1.14.3",
    "toastr": "^2.1.4",
    "vue": "^2.5.16"
  },
  "devDependencies": {
    "electron-packager": "^17.1.2",
    "electron": "^1.8.4"
  }
}
